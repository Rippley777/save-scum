{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Save Scum",
  "version": "0.1.0",
  "identifier": "app.savescum.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Save Scum",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#101211"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Your bad decisions are reversible.",
    "longDescription": "Local versioned backups for game saves. Automatic snapshots, safe restores, and a Panic Button."
  }
}
