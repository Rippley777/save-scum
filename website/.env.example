# Optional build-time overrides. Defaults work without this file.
PUBLIC_SITE_URL=https://savescum.oddware.dev
# Set only after verifying a public repository / actual release asset.
PUBLIC_GITHUB_URL=
PUBLIC_DOWNLOAD_URL=
PUBLIC_DOWNLOAD_PLATFORM=
PUBLIC_LICENSE_URL=
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
# Use preview on non-production builds. The deployment workflow sets this.
SITE_ENV=production

# House Edge browser analytics. Leave key/endpoint empty to disable.
# Use the browser ingestion key and exact collector URL (ending in /api/collect).
# These public values are embedded at build time; rebuild after changes.
PUBLIC_HOUSE_EDGE_PROJECT=save-scum-website
PUBLIC_HOUSE_EDGE_KEY=
PUBLIC_HOUSE_EDGE_ENDPOINT=
# Opt in only when testing against a development analytics project.
PUBLIC_HOUSE_EDGE_TRACK_DEVELOPMENT=false
