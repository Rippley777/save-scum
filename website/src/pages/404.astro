---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Save State Not Found | Save Scum"
  description="This checkpoint does not exist. Return to Save Scum, check release status, or explore the documentation."
  canonical="/404.html"
  noindex
>
  <section class="container error-page">
    <span class="cta-symbol" aria-hidden="true">
      ↶
    </span>
    <p class="eyebrow">404 / CHECKPOINT MISSING</p>
    <h1>Save state not found.</h1>
    <p>Looks like this timeline doesn’t have that checkpoint.</p>
    <div class="actions">
      <a class="button" href="/">
        Back to the beginning
      </a>
      <a class="button secondary" href="/download/">
        Release status
      </a>
      <a class="text-link" href="/docs/">
        Documentation →
      </a>
    </div>
  </section>
</Layout>
