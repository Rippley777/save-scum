---
interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
---

<a class:list={["brand", { small }]} href="/" aria-label="Save Scum home">
  <svg
    width="34"
    height="34"
    viewBox="0 0 34 34"
    fill="none"
    aria-hidden="true"
  >
    <rect x="1" y="1" width="32" height="32" rx="9" fill="currentColor" />
    <path
      d="M10 9h12l3 3v13H9V9h1Zm3 0v6h8V9M13 25v-7h8v7"
      stroke="#14200e"
      stroke-width="2"
      stroke-linejoin="round"
    />
    <path
      d="m5 18 4-4 4 4"
      stroke="#14200e"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span>
    SAVE SCUM<span class="brand-dot">.</span>
  </span>
</a>
