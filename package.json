{
  "license": "SEE LICENSE IN LICENSE",
  "name": "save-scum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:desktop": "node scripts/version.mjs check && tauri build -- --locked",
    "build:windows": "node scripts/release.mjs local --platform windows --arch x86_64",
    "build:linux": "node scripts/release.mjs local --platform linux --arch x86_64",
    "build:mac": "node scripts/release.mjs local --platform macos",
    "release": "node scripts/release.mjs local",
    "release:local": "node scripts/release.mjs local",
    "release:ci": "node scripts/release.mjs dispatch",
    "release:recover": "node scripts/release.mjs recover",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "typecheck": "tsc --noEmit",
    "format:release": "prettier --write scripts/*.mjs docs/BUILDING.md .github/workflows/build-release.yml .github/workflows/ci.yml package.json src-tauri/tauri.conf.json",
    "lint:release": "prettier --check scripts/*.mjs docs/BUILDING.md .github/workflows/build-release.yml .github/workflows/ci.yml package.json src-tauri/tauri.conf.json && node --check scripts/version.mjs && node --check scripts/release-store.mjs && node --check scripts/release-artifacts.mjs && node --check scripts/release.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "cargo test -p save-scum-core",
    "test:ui": "playwright test",
    "release:desktop": "node scripts/macos-release.mjs",
    "release:mac": "node scripts/macos-release.mjs",
    "release:mac:check": "node scripts/macos-release.mjs --check",
    "release:mac:sign": "node scripts/macos-release.mjs --sign-only",
    "test:macos-release": "node --test scripts/macos-release.test.mjs"
  },
  "dependencies": {
    "@house-edge/analytics": "file:vendor/house-edge-analytics-0.1.1.tgz",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
